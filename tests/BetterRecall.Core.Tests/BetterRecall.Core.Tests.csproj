<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.20348.0</SupportedOSPlatformVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);xUnit1031;xUnit1030</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Seam tests (Sweep4USeamTests): the UI's XAML-free client logic (MIT) against the real command processor on a
         real pipe. MIT code compiled into this AGPL project is fine; UI.Tests keeps no backend reference. -->
    <Compile Include="..\..\src\BetterRecall.UI\Logic\**\*.cs" Link="UiLogic\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\BetterRecall.Contracts\BetterRecall.Contracts.csproj" />
    <ProjectReference Include="..\..\src\BetterRecall.Core\BetterRecall.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
