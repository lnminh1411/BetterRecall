  <ItemGroup>
    <ProjectReference Include="..\..\src\BetterRecall.Contracts\BetterRecall.Contracts.csproj" />
    <ProjectReference Include="..\..\src\BetterRecall.Core\BetterRecall.Core.csproj" />
    <ProjectReference Include="..\..\src\BetterRecall.Mcp\BetterRecall.Mcp.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
