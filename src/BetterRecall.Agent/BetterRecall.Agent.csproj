<Project Sdk="Microsoft.NET.Sdk">
  <!-- The agent is the Rust crate rust\crates\br-agent (Core is in-process as br-core). This project builds it with cargo
       and ships BetterRecall.Agent.exe with the native DLLs it loads from its own folder; no managed file ships. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.20348.0</SupportedOSPlatformVersion>
    <OutputType>Library</OutputType>
    <SelfContained>false</SelfContained>
    <UseAppHost>false</UseAppHost>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DebugType>none</DebugType>
    <CopyBuildOutputToPublishDirectory>false</CopyBuildOutputToPublishDirectory>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Native libraries only, from the same packages the C# agent used: SQLite3 Multiple Ciphers (MIT) for the encrypted
         store and Skia (BSD-3-Clause) for WebP and JPEG keyframes. br-agent loads them with libloading from its folder. -->
    <PackageReference Include="SQLite3MC.PCLRaw.lib" Version="2.6.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.1" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\assets\icons\tray-dark.ico" Link="icons\tray-dark.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\assets\icons\tray-light.ico" Link="icons\tray-light.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- oneVPL dispatcher (Intel, MIT) for AV1 through the Intel GPU runtime; loaded from the install folder first. -->
    <None Include="Native\libvpl.dll" Link="libvpl.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Native\libvpl.LICENSE.txt" Link="libvpl.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- AVIF (libavif + aom + dav1d) and JPEG XL (libjxl) keyframe codecs, vcpkg builds with a static CRT; see codecs.LICENSE.txt. -->
    <None Include="Native\avif.dll" Link="avif.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Native\jxl.dll" Link="jxl.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Native\jxl_cms.dll" Link="jxl_cms.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Native\jxl_threads.dll" Link="jxl_threads.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Native\codecs.LICENSE.txt" Link="codecs.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <_AgentTrimFile Include="BetterRecall.Agent.dll;BetterRecall.Agent.pdb;BetterRecall.Agent.deps.json;BetterRecall.Agent.runtimeconfig.json" />
    <_AgentTrimFile Include="libSkiaSharp.pdb;sqlite3mc.pdb" />
    <!-- Windows SDK projection the windows TargetFramework copies in; the Rust exe does not use it. -->
    <_AgentTrimFile Include="Microsoft.Windows.SDK.NET.dll;WinRT.Runtime.dll" />
  </ItemGroup>
  <Target Name="BuildRustAgent" AfterTargets="Build" BeforeTargets="ComputeFilesToPublish">
    <PropertyGroup>
      <_RustDir>$(MSBuildThisFileDirectory)..\..\rust</_RustDir>
      <_CargoProfile Condition="'$(Configuration)' == 'Release'">release</_CargoProfile>
      <_CargoProfile Condition="'$(Configuration)' != 'Release'">debug</_CargoProfile>
      <_CargoProfileFlag Condition="'$(Configuration)' == 'Release'">--release</_CargoProfileFlag>
      <_CargoTargetDirRaw Condition="'$(CARGO_TARGET_DIR)' != ''">$(CARGO_TARGET_DIR)</_CargoTargetDirRaw>
      <_CargoTargetDirRaw Condition="'$(CARGO_TARGET_DIR)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\artifacts\cargo'))</_CargoTargetDirRaw>
      <_CargoTargetDir>$(_CargoTargetDirRaw.TrimEnd('\').TrimEnd('/'))</_CargoTargetDir>
      <_RustAgentExe>$(_CargoTargetDir)\$(_CargoProfile)\br-agent.exe</_RustAgentExe>
    </PropertyGroup>
    <Exec Command="where cargo &gt;nul 2&gt;nul" IgnoreExitCode="true" EchoOff="true" StandardOutputImportance="Low" StandardErrorImportance="Low">
      <Output TaskParameter="ExitCode" PropertyName="_CargoCheckExit" />
    </Exec>
    <Error Condition="'$(_CargoCheckExit)' != '0'"
           Text="cargo was not found on PATH. Install the Rust toolchain with rustup (https://rustup.rs) using the stable x86_64-pc-windows-msvc target." />
    <Exec WorkingDirectory="$(_RustDir)"
          Command="cargo build -p br-agent $(_CargoProfileFlag) -j 4 --target-dir &quot;$(_CargoTargetDir)&quot;" />
    <Copy SourceFiles="$(_RustAgentExe)"
          DestinationFiles="$(TargetDir)BetterRecall.Agent.exe"
          OverwriteReadOnlyFiles="true"
          SkipUnchangedFiles="false" />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)BetterRecall.Agent.exe">
        <RelativePath>BetterRecall.Agent.exe</RelativePath>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <!-- Trim the managed wrapper files; only the exe, its native DLLs, licences and tray icons remain. -->
  <Target Name="TrimAgentBuild" AfterTargets="BuildRustAgent">
    <Delete Files="@(_AgentTrimFile->'$(TargetDir)%(Identity)')" />
  </Target>
  <Target Name="TrimAgentPublish" AfterTargets="Publish">
    <Delete Files="@(_AgentTrimFile->'$(PublishDir)%(Identity)')" />
  </Target>
</Project>
