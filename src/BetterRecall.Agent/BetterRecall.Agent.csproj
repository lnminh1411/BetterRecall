<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.20348.0</SupportedOSPlatformVersion>
    <OutputType>WinExe</OutputType>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>BetterRecall.Agent</AssemblyName>
    <RootNamespace>BetterRecall.Agent</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableComHosting>false</EnableComHosting>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <IsAotCompatible>true</IsAotCompatible>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\icons\app.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="BetterRecall.Agent.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- oneVPL dispatcher (Intel, MIT) for AV1 through the Intel GPU runtime; loaded from the install folder first. -->
    <None Include="..\..\assets\icons\tray-dark.ico" Link="icons\tray-dark.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\assets\icons\tray-light.ico" Link="icons\tray-light.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="native\libvpl.dll" Link="libvpl.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="native\libvpl.LICENSE.txt" Link="libvpl.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- AVIF (libavif + aom + dav1d) and JPEG XL (libjxl) keyframe codecs, vcpkg builds with a static CRT; see codecs.LICENSE.txt. -->
    <None Include="native\avif.dll" Link="avif.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="native\jxl.dll" Link="jxl.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="native\jxl_cms.dll" Link="jxl_cms.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="native\jxl_threads.dll" Link="jxl_threads.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="native\codecs.LICENSE.txt" Link="codecs.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BetterRecall.Contracts\BetterRecall.Contracts.csproj" />
    <ProjectReference Include="..\BetterRecall.Core\BetterRecall.Core.csproj" />
  </ItemGroup>
</Project>
