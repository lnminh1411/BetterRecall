<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.20348.0</SupportedOSPlatformVersion>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>BetterRecall.Contracts</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BetterRecallReleasePubKey)' != ''">
    <DefineConstants>$(DefineConstants);BR_RELEASE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(BetterRecallReleasePubKey)' != ''">
    <EmbeddedResource Include="$(BetterRecallReleasePubKey)" LogicalName="BetterRecall.Contracts.release_pubkey.pem" />
  </ItemGroup>
</Project>
