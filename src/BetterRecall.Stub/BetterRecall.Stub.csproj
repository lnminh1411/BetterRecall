<Project Sdk="Microsoft.NET.Sdk">
  <!-- D6: the small payload-less exe the launcher copies to <data>\app\bin twice. As bin\BetterRecall.exe (autostart) it
       starts the install bin\current names; as bin\betterrecall-mcp.exe it relays MCP stdio to that install's server and
       follows upgrades. Paths in it stay fixed across versions, unlike the versioned install folders. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.20348.0</SupportedOSPlatformVersion>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>..\..\assets\icons\app.ico</ApplicationIcon>
    <PublishAot>true</PublishAot>
    <AssemblyName>BetterRecall.Stub</AssemblyName>
    <RootNamespace>BetterRecall.Stub</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="BetterRecall.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- bin\ is user-writable: static imports load from System32 only, never from next to the exe (no DLL planting). -->
    <LinkerArg Include="/DEPENDENTLOADFLAG:0x800" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BetterRecall.Contracts\BetterRecall.Contracts.csproj" />
  </ItemGroup>
</Project>
