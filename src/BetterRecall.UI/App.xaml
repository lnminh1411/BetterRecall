<Application
    x:Class="BetterRecall.UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:BetterRecall.UI.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <views:Templates />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="16,12" />
            </Style>

            <!-- Destructive actions: critical fill with the on-accent text colour, readable in light and dark. -->
            <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <!-- Theme-aware styles for elements built in code. A brush read from Application.Current.Resources is the
                 app theme's brush and stays wrong when ui.theme differs from Windows; style setters with ThemeResource
                 follow the element's own theme. -->
            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="CriticalTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
            <Style x:Key="CaptionSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="CaptionCriticalTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
            <Style x:Key="AccentIconStyle" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="KeyChipStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1,1,1,2" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="8,2,8,3" />
            </Style>
            <Style x:Key="OutlinedListViewStyle" TargetType="ListView" BasedOn="{StaticResource DefaultListViewStyle}">
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            <Style x:Key="BarAccentStyle" TargetType="Rectangle">
                <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>
            <Style x:Key="BarMutedStyle" TargetType="Rectangle">
                <Setter Property="Fill" Value="{ThemeResource ControlStrongFillColorDisabledBrush}" />
            </Style>
            <Style x:Key="DotSuccessStyle" TargetType="Ellipse">
                <Setter Property="Fill" Value="{ThemeResource SystemFillColorSuccessBrush}" />
            </Style>
            <Style x:Key="DotCautionStyle" TargetType="Ellipse">
                <Setter Property="Fill" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <Style x:Key="DotCriticalStyle" TargetType="Ellipse">
                <Setter Property="Fill" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
            <Style x:Key="DotNeutralStyle" TargetType="Ellipse">
                <Setter Property="Fill" Value="{ThemeResource SystemFillColorNeutralBrush}" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
