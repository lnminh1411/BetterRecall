<Page
    x:Class="BetterRecall.UI.Views.ConsentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,16,32,32" Spacing="14" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock x:Uid="Consent_Title" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Uid="Consent_Intro" TextWrapping="Wrap" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock x:Uid="Consent_WhatTitle" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock x:Uid="Consent_What1" TextWrapping="Wrap" />
                    <TextBlock x:Uid="Consent_What2" TextWrapping="Wrap" />
                    <TextBlock x:Uid="Consent_What3" TextWrapping="Wrap" />
                    <TextBlock x:Uid="Consent_What4" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock x:Uid="Consent_WhereTitle" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock x:Uid="Consent_Where1" TextWrapping="Wrap" />
                    <TextBlock x:Uid="Consent_Where2" TextWrapping="Wrap" />
                    <TextBlock x:Uid="Consent_Where3" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock x:Uid="Consent_ProtectTitle" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock x:Uid="Consent_Protect1" TextWrapping="Wrap" />
                    <TextBlock x:Uid="Consent_Protect2" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <InfoBar x:Uid="Consent_Limit" IsOpen="True" IsClosable="False" Severity="Warning" />

            <StackPanel x:Name="ConsentButtons" Orientation="Horizontal" Spacing="8">
                <Button x:Name="AgreeButton" x:Uid="Consent_Agree" Style="{StaticResource AccentButtonStyle}" Click="Agree_Click" />
                <Button x:Uid="Consent_NotNow" Click="NotNow_Click" />
                <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" />
            </StackPanel>
            <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="False" Severity="Error" />

            <Border x:Name="BenchOffer" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="Consent_BenchTitle" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock x:Uid="Consent_BenchBody" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BenchRunButton" x:Uid="Consent_BenchRun" Style="{StaticResource AccentButtonStyle}" Click="BenchRun_Click" />
                        <Button x:Uid="Consent_BenchSkip" Click="BenchSkip_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
