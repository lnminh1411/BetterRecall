<Page
    x:Class="BetterRecall.UI.Views.ShortcutsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Global shortcuts: one row per action with its keys, Change (press-to-record dialog) and Remove. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel Padding="24,8,24,24" Spacing="12" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock x:Uid="Shortcuts_Title" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Uid="Shortcuts_Desc" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
            <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="True" Severity="Warning" />
            <Border Style="{StaticResource CardStyle}" Padding="16,4">
                <StackPanel x:Name="Rows" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
