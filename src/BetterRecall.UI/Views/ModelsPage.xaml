<Page
    x:Class="BetterRecall.UI.Views.ModelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:BetterRecall.UI.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageStackStyle}" Spacing="12" MaxWidth="920">
            <TextBlock x:Uid="ModelsPage_Title" Style="{StaticResource PageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Uid="ModelsPage_Desc" TextWrapping="Wrap" Margin="0,-8,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True" Closed="ResultBar_Closed" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="DownloadMinimalButton" Style="{StaticResource AccentButtonStyle}" Click="DownloadMinimal_Click" />
                        <Button x:Name="DownloadFullButton" Click="DownloadFull_Click" />
                        <ProgressRing x:Name="LoadingRing" IsActive="False" Width="20" Height="20" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Spacing="6">
                        <ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="100" Value="0" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ProgressText" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       AutomationProperties.LiveSetting="Polite" />
                            <Button x:Name="CancelButton" x:Uid="ModelsPage_Cancel" Grid.Column="1" Click="Cancel_Click" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ItemsControl x:Name="ComponentsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="views:ModelComponentView">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind MetaLine}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" VerticalAlignment="Center"
                                        Content="{x:Bind DownloadLabel}"
                                        Tag="{x:Bind Id}"
                                        Visibility="{x:Bind DownloadVisibility}"
                                        IsEnabled="{x:Bind CanDownload}"
                                        Click="DownloadComponent_Click" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="ModelsPage_FolderTitle" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock x:Name="FolderPathText" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                               FontFamily="Consolas" Style="{StaticResource CaptionTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="OpenFolderButton" x:Uid="ModelsPage_OpenFolder" Click="OpenFolder_Click" />
                        <Button x:Name="RefreshButton" x:Uid="ModelsPage_Refresh" Click="Refresh_Click" />
                    </StackPanel>
                    <TextBlock x:Uid="ModelsPage_ManualTitle" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />
                    <TextBlock x:Uid="ModelsPage_ManualNote" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
