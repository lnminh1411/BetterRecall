<UserControl
    x:Class="BetterRecall.UI.Views.DetailPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="EmptyText" x:Uid="Detail_Empty" Grid.RowSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Grid x:Name="ImageHost" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}" MinHeight="120">
            <Image x:Name="KeyframeImage" Stretch="Uniform" MaxHeight="420" />
            <FontIcon x:Name="AudioIcon" Glyph="&#xE720;" FontSize="40" Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw" />
            <ProgressRing x:Name="Busy" IsActive="False" Width="28" Height="28" />
        </Grid>
        <StackPanel x:Name="Meta" Grid.Row="1" Spacing="2">
            <TextBlock x:Name="TitleText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <TextBlock x:Name="AppText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
            <TextBlock x:Name="TimeText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <InfoBar x:Name="ErrorBar" IsClosable="False" Severity="Warning" IsOpen="False" />
            <StackPanel x:Name="Actions" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                <Button x:Name="ReplayButton" Visibility="Collapsed" Click="Replay_Click" />
                <Button x:Name="DescribeButton" Visibility="Collapsed" Click="Describe_Click" />
                <ProgressRing x:Name="DescribeBusy" IsActive="False" Width="20" Height="20" />
            </StackPanel>
            <InfoBar x:Name="DescribeBar" IsClosable="True" Severity="Informational" IsOpen="False" />
        </StackPanel>
        <ScrollViewer x:Name="TranscriptScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="4">
                <TextBlock x:Uid="Detail_Transcript" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock x:Name="TranscriptText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
