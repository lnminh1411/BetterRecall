<Page
    x:Class="BetterRecall.UI.Views.SettingsShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Settings open as their own page with a group list, like Windows Terminal and PowerToys settings. -->
    <!-- Narrow page (main nav already folded to icons): the groups move to a top strip with names instead of a second
         icon rail (sweep 3 D15); code-behind switches PaneDisplayMode. -->
    <NavigationView x:Name="Groups" PaneDisplayMode="Left" OpenPaneLength="240" IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False" IsPaneToggleButtonVisible="False" IsTitleBarAutoPaddingEnabled="False"
                    ItemInvoked="Groups_ItemInvoked" CompactModeThresholdWidth="0" ExpandedModeThresholdWidth="860">
        <NavigationView.PaneHeader>
            <TextBlock x:Uid="Settings_ShellTitle" Margin="16,8,0,8" Style="{StaticResource SubtitleTextBlockStyle}"
                       AutomationProperties.HeadingLevel="Level1" />
        </NavigationView.PaneHeader>
        <Frame x:Name="GroupFrame" />
    </NavigationView>
</Page>
