<Window
    x:Class="BetterRecall.UI.Views.LauncherWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:logic="using:BetterRecall.UI.Logic"
    xmlns:views="using:BetterRecall.UI.Views">
    <Grid x:Name="Root" PreviewKeyDown="Root_PreviewKeyDown">
        <Grid.Resources>
            <CollectionViewSource x:Name="GroupsSource" IsSourceGrouped="True" />

            <!-- Search result card: "Found <query> · 6d ago", the ... menu, the thumbnail with the app or site badge.
                 ThumbLoader sets ThumbImage when the card is realised. -->
            <DataTemplate x:Key="ResultCardTemplate" x:DataType="logic:CaptureItem">
                <Grid Width="264" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                      AutomationProperties.Name="{x:Bind AccessibleName}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="142" />
                    </Grid.RowDefinitions>
                    <Grid Padding="10,2,2,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" FontSize="13">
                            <Run x:Uid="Card_Found" /><Run Text="{x:Bind Query}" FontWeight="SemiBold" /><Run Text="  ·  " Foreground="{ThemeResource TextFillColorTertiaryBrush}" /><Run Text="{x:Bind Ago}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </TextBlock>
                        <Button x:Uid="Card_More" Grid.Column="1" Width="32" Height="30" Padding="0" Background="Transparent" BorderThickness="0"
                                Click="More_Click">
                            <FontIcon Glyph="&#xE712;" FontSize="14" />
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1" Margin="6,0,6,6" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Image x:Name="ThumbImage" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Visibility="{x:Bind IsAudio}" Padding="12,10,12,34" Spacing="6">
                            <FontIcon Glyph="&#xE720;" FontSize="20" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Bind TileText}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" FontSize="13" />
                        </StackPanel>
                        <Border Visibility="{x:Bind IsWeak}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="6,2" CornerRadius="4"
                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                            <TextBlock x:Uid="Tile_Weak" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        </Border>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Padding="3,3,10,3" CornerRadius="13"
                                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Grid Width="20" Height="20">
                                    <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Text="{x:Bind BadgeInitial}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Grid>
                                <TextBlock Text="{x:Bind BadgeText}" FontSize="12" MaxWidth="190" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="16,16,16,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" x:Uid="Launcher_SearchBox" FontSize="20" Padding="12,8,44,8"
                     TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />
            <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" HorizontalAlignment="Right" Margin="0,0,14,0" IsHitTestVisible="False" />
            <!-- The launcher has no title bar: this and Esc close it; clicking elsewhere hides it too. -->
            <ToggleButton x:Name="AskToggle" x:Uid="Launcher_AskToggle" Grid.Column="1" VerticalAlignment="Stretch" Width="44" Padding="0"
                          Checked="AskToggle_Changed" Unchecked="AskToggle_Changed">
                <FontIcon Glyph="&#xE8BD;" FontSize="16" />
            </ToggleButton>
            <Button x:Name="CloseButton" Grid.Column="2" VerticalAlignment="Stretch" Width="44" Padding="0"
                    Background="Transparent" BorderThickness="0" Click="Close_Click">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>

        <Grid x:Name="FilterRow" Grid.Row="1" Padding="16,0,16,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="RangeBox" x:Uid="Launcher_Range" MinWidth="150" SelectedIndex="0" SelectionChanged="Filter_Changed">
                <ComboBoxItem x:Uid="Range_Any" />
                <ComboBoxItem x:Uid="Range_LastHour" />
                <ComboBoxItem x:Uid="Range_Today" />
                <ComboBoxItem x:Uid="Range_Last7Days" />
                <ComboBoxItem x:Uid="Range_Last30Days" />
            </ComboBox>
            <ComboBox x:Name="KindBox" x:Uid="Launcher_Kind" Grid.Column="1" MinWidth="130" SelectedIndex="0" SelectionChanged="Filter_Changed">
                <ComboBoxItem x:Uid="Kind_All" />
                <ComboBoxItem x:Uid="Kind_Screen" />
                <ComboBoxItem x:Uid="Kind_Audio" />
            </ComboBox>
            <ComboBox x:Name="AppBox" x:Uid="Launcher_AppFilter" Grid.Column="2" MinWidth="150" MaxWidth="240" SelectionChanged="Facet_Changed" />
            <ComboBox x:Name="SiteBox" x:Uid="Launcher_SiteFilter" Grid.Column="3" MinWidth="150" MaxWidth="240" SelectionChanged="Facet_Changed" />
            <TextBlock x:Name="MessageText" Grid.Column="4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>
            <GridView x:Name="ResultsGrid" x:Uid="Launcher_Results" Padding="12,0,4,8" SelectionMode="Single"
                      ItemTemplate="{StaticResource ResultCardTemplate}"
                      SelectionChanged="ResultsGrid_SelectionChanged" PreviewKeyDown="ResultsGrid_PreviewKeyDown"
                      IsItemClickEnabled="True" ItemClick="ResultsGrid_ItemClick" ContextRequested="ResultsGrid_ContextRequested">
                <GridView.GroupStyle>
                    <GroupStyle HidesIfEmpty="True">
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="logic:ResultGroup">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{x:Bind Header}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16" VerticalAlignment="Center"
                                               AutomationProperties.HeadingLevel="Level2" />
                                    <Border Padding="8,1" CornerRadius="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Total, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Border>
                                    <HyperlinkButton Content="{x:Bind MoreText}" Visibility="{x:Bind HasMore, Mode=OneWay}" Padding="6,2"
                                                     Click="ShowAll_Click" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </GridView.GroupStyle>
            </GridView>
            <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Padding="24" IsHitTestVisible="False">
                <FontIcon Glyph="&#xE721;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Uid="Launcher_EmptyHint" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Grid x:Name="HistoryPanel" Padding="24,4,24,8" RowSpacing="4" MaxWidth="620" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock x:Uid="History_Title" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                    <HyperlinkButton x:Uid="History_Clear" HorizontalAlignment="Right" Click="ClearHistory_Click" />
                </Grid>
                <ListView x:Name="HistoryList" x:Uid="History_List" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="History_ItemClick" MinWidth="420">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnSpacing="12" AutomationProperties.Name="{x:Bind}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE81C;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button x:Uid="History_Delete" Grid.Column="2" Width="32" Height="28" Padding="0" Background="Transparent" BorderThickness="0"
                                        Tag="{x:Bind}" Click="DeleteHistory_Click">
                                    <FontIcon Glyph="&#xE711;" FontSize="11" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            <views:ChatView x:Name="AskView" Visibility="Collapsed" />
            <Border Grid.Column="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <views:DetailPane x:Name="Detail" />
            </Border>
        </Grid>

        <Grid Grid.Row="3" Padding="16,6" ColumnSpacing="8" Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusLine" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <HyperlinkButton x:Uid="Launcher_Timeline" Click="OpenTimeline_Click" />
                <HyperlinkButton x:Uid="Launcher_Replays" Click="OpenReplays_Click" />
                <HyperlinkButton x:Uid="Launcher_Settings" Click="OpenSettings_Click" />
            </StackPanel>
        </Grid>

        <InfoBar x:Name="OfflineBar" Grid.Row="2" VerticalAlignment="Top" Margin="16,0" IsClosable="False" IsOpen="False" Severity="Error" />
        <views:UnlockPanel x:Name="Unlock" Grid.RowSpan="4" Visibility="Collapsed" />
    </Grid>
</Window>
