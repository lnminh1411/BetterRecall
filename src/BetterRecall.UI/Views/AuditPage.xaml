<Page
    x:Class="BetterRecall.UI.Views.AuditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:BetterRecall.UI.Views">
    <Grid Padding="24,8,24,16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Uid="Audit_Title" Style="{StaticResource PageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="Audit_Desc" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ProgressRing x:Name="Busy" Grid.Column="1" IsActive="False" Width="20" Height="20" />
            <Button x:Uid="Audit_Refresh" Grid.Column="2" Click="Refresh_Click" />
        </Grid>
        <Grid Grid.Row="2" Padding="12,4" ColumnSpacing="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" MinWidth="120" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="Audit_ColTime" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock x:Uid="Audit_ColPipe" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock x:Uid="Audit_ColVerb" Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock x:Uid="Audit_ColCount" Grid.Column="3" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock x:Uid="Audit_ColPid" Grid.Column="4" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock x:Uid="Audit_ColClient" Grid.Column="5" Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>
        <ListView x:Name="List" x:Uid="Audit_List" Grid.Row="3" SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="views:AuditRow">
                    <Grid ColumnSpacing="12" Padding="0,4" AutomationProperties.Name="{x:Bind AccessibleName}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" MinWidth="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Time}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Entry.Pipe}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Entry.Verb}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Count}" />
                        <TextBlock Grid.Column="4" Text="{x:Bind Pid}" />
                        <StackPanel Grid.Column="5">
                            <TextBlock Text="{x:Bind Entry.ClientImage}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                            <TextBlock Text="{x:Bind QueryHash}" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <InfoBar x:Name="ErrorBar" Grid.Row="3" VerticalAlignment="Top" IsOpen="False" IsClosable="False" Severity="Error" />
    </Grid>
</Page>
