<Page
    x:Class="BetterRecall.UI.Views.BenchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:BetterRecall.UI.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,8,24,24" Spacing="12" MaxWidth="1100" HorizontalAlignment="Stretch">
            <TextBlock x:Uid="BenchPage_Title" Style="{StaticResource PageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Uid="BenchPage_Desc" TextWrapping="Wrap" Margin="0,-8,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="RunButton" x:Uid="BenchPage_Run" Style="{StaticResource AccentButtonStyle}" Click="Run_Click" />
                <Button x:Name="CancelButton" x:Uid="BenchPage_Cancel" Visibility="Collapsed" Click="Cancel_Click" />
                <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True" />

            <Border x:Name="HardwareCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="BenchPage_HardwareTitle" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <StackPanel x:Name="HardwareLines" Spacing="2" />
                </StackPanel>
            </Border>

            <Border x:Name="RecsCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="BenchPage_RecsTitle" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <Grid x:Name="RecsHeader" ColumnSpacing="12" Padding="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="BenchPage_ColSetting" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Uid="BenchPage_ColCurrent" Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Uid="BenchPage_ColProposed" Grid.Column="3" Style="{StaticResource CaptionTextBlockStyle}" />
                    </Grid>
                    <ItemsControl x:Name="RecList" x:Uid="BenchPage_Recs">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="views:RecView">
                                <Grid ColumnSpacing="12" Padding="0,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{x:Bind Row.Selected, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Top"
                                              AutomationProperties.Name="{x:Bind AccessibleName}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Setting}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Reason}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Row.Error, Mode=OneWay}" Visibility="{x:Bind views:RecView.Shown(Row.Error), Mode=OneWay}"
                                                   TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                   AutomationProperties.LiveSetting="Assertive" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Current}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Proposed}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="ApplyButton" x:Uid="BenchPage_Apply" Style="{StaticResource AccentButtonStyle}" Click="Apply_Click" />
                </StackPanel>
            </Border>

            <Expander x:Name="RawExpander" x:Uid="BenchPage_RawTitle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="BenchPage_InferenceTitle" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level3" />
                    <Grid x:Name="InferenceTable" ColumnSpacing="16" RowSpacing="4" />
                    <TextBlock x:Uid="BenchPage_CaptureTitle" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level3" />
                    <StackPanel x:Name="CaptureLines" Spacing="2" />
                    <TextBlock x:Uid="BenchPage_EncoderTitle" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level3" />
                    <Grid ColumnSpacing="10" Padding="12,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="35" />
                            <ColumnDefinition Width="55" />
                            <ColumnDefinition Width="45" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" MinWidth="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="BenchPage_ColAdapter" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Uid="BenchPage_ColCodec" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Uid="BenchPage_ColApi" Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Uid="BenchPage_ColLayout" Grid.Column="3" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Uid="BenchPage_ColSize" Grid.Column="4" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Uid="BenchPage_ColFps" Grid.Column="5" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Uid="BenchPage_ColP95" Grid.Column="6" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Uid="BenchPage_ColCpu" Grid.Column="7" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Uid="BenchPage_ColMb" Grid.Column="8" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Uid="BenchPage_ColResult" Grid.Column="9" Style="{StaticResource CaptionTextBlockStyle}" />
                    </Grid>
                    <ListView x:Name="EncoderList" x:Uid="BenchPage_Encoders" MaxHeight="420" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="MinHeight" Value="30" />
                                <Setter Property="Padding" Value="12,2" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="views:EncoderView">
                                <Grid ColumnSpacing="10" AutomationProperties.Name="{x:Bind AccessibleName}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="35" />
                                        <ColumnDefinition Width="55" />
                                        <ColumnDefinition Width="45" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" MinWidth="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind E.Adapter}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind E.Codec}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind E.Api}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Layout}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Size}" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind Fps}" />
                                    <TextBlock Grid.Column="6" Text="{x:Bind P95}" />
                                    <TextBlock Grid.Column="7" Text="{x:Bind Cpu}" />
                                    <TextBlock Grid.Column="8" Text="{x:Bind Mb}" />
                                    <TextBlock Grid.Column="9" Text="{x:Bind Result}" TextTrimming="CharacterEllipsis" Foreground="{x:Bind ResultBrush}">
                                        <ToolTipService.ToolTip><TextBlock Text="{x:Bind Result}" TextWrapping="Wrap" /></ToolTipService.ToolTip>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
