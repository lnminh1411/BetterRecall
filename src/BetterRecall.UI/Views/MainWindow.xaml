<Window
    x:Class="BetterRecall.UI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:BetterRecall.UI.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarArea" Padding="16,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE81C;" FontSize="16" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" PaneDisplayMode="Auto"
                        OpenPaneLength="260" ItemInvoked="Nav_ItemInvoked" DisplayModeChanged="Nav_DisplayModeChanged" IsPaneToggleButtonVisible="True">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="Nav_Home" Tag="home">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Timeline" Tag="timeline">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Replays" Tag="replays">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE714;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Bench" Tag="bench">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEC4A;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Danger" Tag="danger">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7BA;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Audit" Tag="audit">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Shortcuts" Tag="shortcuts">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE765;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Grid>
                <Frame x:Name="ContentFrame" />
                <InfoBar x:Name="OfflineBar" VerticalAlignment="Top" Margin="24,8" IsClosable="False" IsOpen="False" Severity="Error" />
                <InfoBar x:Name="StorageBar" VerticalAlignment="Bottom" Margin="24,8" IsClosable="True" IsOpen="False" Severity="Warning"
                         Closed="StorageBar_Closed" />
                <views:UnlockPanel x:Name="Unlock" Visibility="Collapsed" />
            </Grid>
        </NavigationView>

        <Grid x:Name="StatusBar" Grid.Row="2" Padding="16,4" ColumnSpacing="8" Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusLine" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button x:Name="PauseButton" Click="Pause_Click" />
                <Button x:Name="LockButton" Click="Lock_Click" />
                <Button x:Uid="Main_Search" Click="Search_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
