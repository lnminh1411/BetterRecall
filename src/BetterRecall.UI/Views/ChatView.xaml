<UserControl
    x:Class="BetterRecall.UI.Views.ChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:contracts="using:BetterRecall.Contracts"
    xmlns:logic="using:BetterRecall.UI.Logic"
    xmlns:views="using:BetterRecall.UI.Views">
    <Grid RowSpacing="8" Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Off state banner -->
        <Grid x:Name="OffPanel" Grid.RowSpan="4" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <FontIcon Glyph="&#xE8BD;" FontSize="40" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="OffText" Grid.Row="1" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" />
            <Button x:Name="OpenSettingsButton" Grid.Row="2" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Click="OpenSettings_Click" />
        </Grid>

        <!-- Top info bars (local info, warnings, errors) -->
        <StackPanel x:Name="TopBannerPanel" Spacing="4">
            <InfoBar x:Name="LocalBar" Severity="Informational" IsOpen="False" IsClosable="False" />
            <InfoBar x:Name="WarningBar" Severity="Warning" IsOpen="False" IsClosable="True" />
            <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True">
                <InfoBar.ActionButton>
                    <Button x:Name="TryAgainButton" Click="TryAgain_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <!-- Middle: chat bubbles -->
        <ScrollViewer x:Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10" Padding="0,4,8,4">
                <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="Collapsed" />
                <ItemsControl x:Name="MessagesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="logic:ChatBubble">
                            <Grid Margin="0,4">
                                <!-- User bubble -->
                                <Border Visibility="{x:Bind IsUser}" HorizontalAlignment="Right" MaxWidth="620" CornerRadius="12,12,2,12"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}" Padding="12,8">
                                    <TextBlock Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>

                                <!-- Assistant bubble -->
                                <Border Visibility="{x:Bind IsAssistant}" HorizontalAlignment="Left" MaxWidth="720" CornerRadius="12,12,12,2"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="12,10">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind views:ChatView.StatusText(Status), Mode=OneWay}" FontStyle="Italic"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Visibility="{x:Bind HasStatus, Mode=OneWay}" />
                                        <ItemsControl ItemsSource="{x:Bind Sources}" Visibility="{x:Bind HasSources, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="contracts:ChatSource">
                                                    <Button Click="Source_Click" Tag="{x:Bind}" Padding="8,4"
                                                            ToolTipService.ToolTip="{x:Bind Title}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE81C;" FontSize="12" />
                                                            <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="200">
                                                                <Run Text="{x:Bind views:ChatView.SourceHeader(App, Site)}" /><Run Text=" · " Foreground="{ThemeResource TextFillColorTertiaryBrush}" /><Run Text="{x:Bind views:ChatView.FormatShortTime(Ts)}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Approval Panel -->
        <Border x:Name="ApprovalPanel" Grid.Row="2" Visibility="Collapsed" CornerRadius="8"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="12" Margin="0,4">
            <StackPanel Spacing="8">
                <TextBlock x:Name="ApprovalTitleBlock" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="ApprovalBodyBlock" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ApprovalList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="logic:ApprovalItemView">
                                <Grid Padding="6,4" ColumnSpacing="10" Margin="0,2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{x:Bind Include, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <Image Grid.Column="1" Width="100" Height="60" Stretch="UniformToFill"
                                           Visibility="{x:Bind HasImage}" Loaded="ApprovalThumb_Loaded" />
                                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                            <Run Text="{x:Bind views:ChatView.SourceHeader(App, Site)}" /><Run Text=" · " Foreground="{ThemeResource TextFillColorTertiaryBrush}" /><Run Text="{x:Bind views:ChatView.FormatLongTime(Ts)}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </TextBlock>
                                        <TextBlock Text="{x:Bind Text}" FontFamily="Consolas, Cascadia Mono, monospace" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
                    <Button x:Name="AllowButton" Style="{StaticResource AccentButtonStyle}" Click="AllowChat_Click" />
                    <Button x:Name="DenyButton" Click="DontShare_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Bottom Input & Usage -->
        <Grid Grid.Row="3" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="36" MaxHeight="120" TextChanged="InputBox_TextChanged" PreviewKeyDown="InputBox_PreviewKeyDown" />
                <Button x:Name="SendButton" Grid.Column="1" VerticalAlignment="Bottom" Height="36"
                        Style="{StaticResource AccentButtonStyle}" Click="SendButton_Click">
                    <FontIcon Glyph="&#xE724;" FontSize="14" />
                </Button>
                <Button x:Name="StopButton" Grid.Column="2" VerticalAlignment="Bottom" Height="36"
                        Visibility="Collapsed" Click="StopButton_Click">
                    <FontIcon Glyph="&#xE71A;" FontSize="14" />
                </Button>
            </Grid>
            <TextBlock Grid.Row="1" x:Name="UsageBlock" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,2,0,0" />
        </Grid>
    </Grid>
</UserControl>
