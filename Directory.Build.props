<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Single version source for every exe, the version verb and MCP serverInfo. -->
    <Version>0.4.0-dev</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>BetterRecall</Product>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    <Authors>BetterRecall contributors</Authors>
    <Company>BetterRecall contributors</Company>
    <!-- One licence for everything (LICENSING.md). -->
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <Copyright>BetterRecall contributors, AGPL-3.0-only</Copyright>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <!-- Optional, not in git: local.runsettings sets BR_TEST_TMP so test data lands on a scratch drive. -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)local.runsettings')">
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)local.runsettings</RunSettingsFilePath>
  </PropertyGroup>
</Project>
